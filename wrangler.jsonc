{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retvy-v2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  "vars": {
    "NODE_ENV": "production",

    // Mets ton vrai domaine prod ici
    "NEXT_PUBLIC_APP_URL": "https://retvy.fr",

    "NEXT_PUBLIC_SUPABASE_URL": "https://bzjmzjdaqkdemzahvssi.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_-i4pyt7dPuVwvkMTCukpNg_xvuUS_hG",

    // Fallback server-side
    "SUPABASE_URL": "https://bzjmzjdaqkdemzahvssi.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_-i4pyt7dPuVwvkMTCukpNg_xvuUS_hG",

    "OPENAI_MODEL": "gpt-4o-mini",
    "BREVO_SENDER_EMAIL": "contact.tattoo@retvy.fr",
    "BREVO_SENDER_NAME": "Retvy",
    // Définir en prod : npx wrangler secret put BREVO_API_KEY --env=""
    "BREVO_API_KEY": "",

    // STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET : npx wrangler secret put … --env=""
    "STRIPE_PRICE_ID": "price_1TZdVSA43PhmUn8w9ydG81MO"
  },

  "env": {
    "preview": {
      "name": "retvy-v2-preview",
      "vars": {
        "NODE_ENV": "production",
        "NEXT_PUBLIC_APP_URL": "https://preview.retvy.fr",
        "NEXT_PUBLIC_SUPABASE_URL": "https://bzjmzjdaqkdemzahvssi.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_-i4pyt7dPuVwvkMTCukpNg_xvuUS_hG",
        "SUPABASE_URL": "https://bzjmzjdaqkdemzahvssi.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_-i4pyt7dPuVwvkMTCukpNg_xvuUS_hG",
        "OPENAI_MODEL": "gpt-4o-mini",
        "BREVO_SENDER_EMAIL": "contact.tattoo@retvy.fr",
        "BREVO_SENDER_NAME": "Retvy",
        // Définir en preview : npx wrangler secret put BREVO_API_KEY --env=preview
        "BREVO_API_KEY": "",
        // STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET : npx wrangler secret put … --env=""
    "STRIPE_PRICE_ID": "price_1TZdVSA43PhmUn8w9ydG81MO"
      }
    }
  }
}